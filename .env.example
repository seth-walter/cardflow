# CardFlow configuration. Copy this file to .env and fill it in:
#   Windows:     copy .env.example .env
#   Mac/Linux:   cp .env.example .env
# The README explains where every value comes from. Never share or commit your .env.

# ---------------------------------------------------------------- card identification
# gemini (recommended, ~1.5 cents a card) or openai. Only the matching key is required.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: a second Gemini key from a project with billing OFF. Used automatically only
# if the paid key runs out of credit (slower, and Google may train on free-tier requests).
GEMINI_FREE_API_KEY=

# ---------------------------------------------------------------------------- eBay
# From developer.ebay.com > My Account > Application Keys > Production keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName ("eBay Redirect URL name") from User Tokens > Get a Token from eBay via Your Application.
EBAY_RUNAME=
# Filled in for you by: python tools/ebay_consent.py
EBAY_USER_TOKEN=
EBAY_REFRESH_TOKEN=
EBAY_SCOPES=

# Filled in for you by: python tools/ebay_setup.py
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID_UNDER_20=
EBAY_FULFILLMENT_POLICY_ID_OVER_20=
EBAY_MERCHANT_LOCATION_KEY=home_us
EBAY_MARKETPLACE_ID=EBAY_US

# --------------------------------------------------------------------- photo hosting
# cloudinary.com > Dashboard shows the cloud name. Settings > Upload > Add upload preset,
# Signing mode: Unsigned.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# -------------------------------------------------------------------------- scanning
# The folder your scanner saves JPEGs into. Keep it out of OneDrive/Dropbox.
SCAN_INBOX_DIR=C:\Scans\CardScans
MAX_CARDS_PER_SESSION=150
SCAN_WORKERS=3
SCAN_POLL_SECONDS=1.0

# ------------------------------------------------------------- pricing (all optional)
# sold-comps.com: real eBay sold prices. Free tier is 100 requests/month.
SOLDCOMPS_API_KEY=
SOLDCOMPS_DAYS=90
SOLDCOMPS_CACHE_DAYS=7
# Best Offer sales in comps: include | exclude | prefer
SOLDCOMPS_OFFER_MODE=include
# PriceCharting / SportsCardsPro paid API token.
PRICECHARTING_TOKEN=
# pokemontcg.io key (works without one, at a lower rate limit).
POKEMONTCG_API_KEY=
# Asking prices run high; multiply them by this (set it with tools/calibrate_prices.py).
ASK_TO_SOLD_FACTOR=1.0
# Flag NEEDS PRICE REVIEW below this many comps or above this high/low spread.
MIN_COMPS_FOR_CONFIDENCE=3
MAX_SPREAD_RATIO=2.5

# -------------------------------------------------------------- listing defaults
# Best Offer: offers below this share of the price are auto-declined.
MIN_OFFER_RATIO=0.20
MIN_OFFER_ABSOLUTE=0.99
# Cards priced under this start as 7-day auctions instead of Buy It Now. 0 turns it off.
AUCTION_UNDER=50
AUCTION_DURATION=DAYS_7
# Lowest opening bid you will ever accept.
AUCTION_MIN_START=0.99
